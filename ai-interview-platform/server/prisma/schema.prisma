// Prisma Schema - AI Interview Platform V1

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum InterviewRole {
  FRONTEND
  BACKEND
  FULLSTACK
  JAVA
  CPP
}

enum InterviewLevel {
  INTERN
  FRESHER
  JUNIOR
}

model User {
  id          Int         @id @default(autoincrement())
  name        String
  email       String      @unique
  password    String
  createdAt   DateTime    @default(now())

  interviews  Interview[]
  resumes      Resume[]
  jobDescriptions JobDescription[]
}

model Resume {
  id          Int      @id @default(autoincrement())
  fileName    String
  resumeText  String
  analysis    Json?
  createdAt   DateTime @default(now())

  userId      Int
  user        User     @relation(fields: [userId], references: [id])

  matchResults MatchResult[]

  @@index([userId])
  
}

model JobDescription {
  id          Int      @id @default(autoincrement())
  title       String?
  company     String?
  description String
  analysis    Json?
  createdAt   DateTime @default(now())
  

  userId      Int
  user        User     @relation(fields: [userId], references: [id])

  matchResults MatchResult[]
  @@index([userId])
}

model Interview {
  id             Int             @id @default(autoincrement())
  role           InterviewRole
  level          InterviewLevel
  totalQuestions Int

  createdAt      DateTime        @default(now())

  userId         Int
  user           User            @relation(fields: [userId], references: [id])

  matchResultId  Int?
  matchResult    MatchResult?    @relation(fields: [matchResultId], references: [id])

  questions      Question[]
  evaluation     Evaluation?

  @@index([matchResultId])
}

model Question {
  id            Int         @id @default(autoincrement())
  question      String
  order         Int

  interviewId   Int
  interview     Interview   @relation(fields: [interviewId], references: [id])

  answer        Answer?
}

model Answer {
  id            Int       @id @default(autoincrement())
  response      String

  questionId    Int       @unique
  question      Question  @relation(fields: [questionId], references: [id])
}

model Evaluation {
  id                    Int        @id @default(autoincrement())

  overallScore          Float
  technicalScore        Float
  communicationScore    Float

  strengths             String
  weaknesses            String
  suggestions           String

  interviewId           Int        @unique
  interview             Interview  @relation(fields: [interviewId], references: [id])

  skillScores            SkillScore[]
}

model SkillScore {
  id            Int        @id @default(autoincrement())

  skill         String
  score         Float

  evaluationId  Int
  evaluation    Evaluation @relation(fields: [evaluationId], references: [id])

  @@index([evaluationId])
}
model MatchResult {
  id                Int      @id @default(autoincrement())
  matchScore        Float

  matchedSkills     Json
  missingSkills     Json
  additionalSkills  Json
  analysis          Json?

  createdAt         DateTime @default(now())

  resumeId          Int
  resume            Resume   @relation(fields: [resumeId], references: [id])

  jobDescriptionId  Int
  jobDescription    JobDescription @relation(fields: [jobDescriptionId], references: [id])

  interviews        Interview[]

  @@index([resumeId])
  @@index([jobDescriptionId])
}